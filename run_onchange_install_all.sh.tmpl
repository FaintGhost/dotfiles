{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# ==========================================
# 辅助函数：进度旋转器
# ==========================================
show_spinner() {
    local pid=$1
    local delay=0.1
    local spinstr='|/-\'
    while kill -0 "$pid" 2>/dev/null; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

execute_with_loader() {
    local msg=$1
    shift
    printf "  > %-30s" "$msg"
    "$@" > /dev/null 2>&1 &
    local pid=$!
    show_spinner "$pid"
    wait "$pid"
    local exit_code=$?
    if [ $exit_code -eq 0 ]; then
        echo -e "${GREEN}完成${NC}"
    else
        echo -e "${RED}失败${NC}"
    fi
    return $exit_code
}

# ==========================================
# 0. 交互式代理配置
# ==========================================
if [ -t 0 ]; then
    echo -e "${BLUE}🌐 Network Configuration / 网络配置${NC}"
    echo "----------------------------------------"
    if read -t 10 -r -p "❓ 是否需要代理? 请输入 IP:Port [10s超时/直接回车跳过]: " proxy_addr < /dev/tty; then
        proxy_addr=$(echo "$proxy_addr" | xargs)
        if [ -n "$proxy_addr" ]; then
            export http_proxy="http://$proxy_addr"
            export https_proxy="http://$proxy_addr"
            export all_proxy="http://$proxy_addr"
            echo -e "${GREEN}✅ 已临时启用代理: $proxy_addr${NC}"
        fi
    fi
fi

# ==========================================
# 1. 基础工具安装 (APT)
# ==========================================
{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}{{ $sudo = "" }}{{ end -}}

echo -e "\n${BLUE}📦 正在同步系统基础软件包 (apt)...${NC}"
execute_with_loader "更新软件包列表" {{ $sudo }}apt update -y
execute_with_loader "检查并同步基础工具" {{ $sudo }}apt install -y {{ .packages.linux.apt | join " " }}

# ==========================================
# 2. 声明式安装工具 (由 .chezmoiexternal 管理)
# ==========================================
echo -e "\n${BLUE}🔧 正在检查声明式开发工具...${NC}"
command_exists() { command -v "$1" >/dev/null 2>&1; }

# 统计变量
BINARY_TOTAL=0
BINARY_INSTALLED=0

{{ range .packages.linux.binaries }}
{{-   if eq . "uv" }}
# uv
BINARY_TOTAL=$((BINARY_TOTAL + 1))
if command_exists uv; then
    UV_VERSION=$(uv --version 2>/dev/null | awk '{print $2}')
    echo -e "  > uv: ${GREEN}已安装${NC} (${BLUE}$UV_VERSION${NC})"
    BINARY_INSTALLED=$((BINARY_INSTALLED + 1))
else
    echo -e "  > uv: ${YELLOW}未安装${NC} (将由 chezmoi external 下载)"
fi
{{-   end }}

{{-   if eq . "bun" }}
# bun
BINARY_TOTAL=$((BINARY_TOTAL + 1))
if [ -f "$HOME/.bun/bin/bun" ]; then
    BUN_VERSION=$($HOME/.bun/bin/bun --version 2>/dev/null)
    echo -e "  > bun: ${GREEN}已安装${NC} (${BLUE}$BUN_VERSION${NC})"
    BINARY_INSTALLED=$((BINARY_INSTALLED + 1))
else
    echo -e "  > bun: ${YELLOW}未安装${NC} (将由 chezmoi external 下载)"
fi
{{-   end }}

{{-   if eq . "starship" }}
# starship
BINARY_TOTAL=$((BINARY_TOTAL + 1))
if command_exists starship; then
    STARSHIP_VERSION=$(starship --version 2>/dev/null | head -1 | awk '{print $2}')
    echo -e "  > starship: ${GREEN}已安装${NC} (${BLUE}$STARSHIP_VERSION${NC})"
    BINARY_INSTALLED=$((BINARY_INSTALLED + 1))
else
    echo -e "  > starship: ${YELLOW}未安装${NC} (将由 chezmoi external 下载)"
fi
{{-   end }}

{{-   if eq . "fnm" }}
# fnm
BINARY_TOTAL=$((BINARY_TOTAL + 1))
if [ -f "$HOME/.local/share/fnm/fnm" ]; then
    FNM_VERSION=$($HOME/.local/share/fnm/fnm --version 2>/dev/null | awk '{print $2}')
    echo -e "  > fnm: ${GREEN}已安装${NC} (${BLUE}$FNM_VERSION${NC})"
    BINARY_INSTALLED=$((BINARY_INSTALLED + 1))
else
    echo -e "  > fnm: ${YELLOW}未安装${NC} (将由 chezmoi external 下载)"
fi
{{-   end }}
{{- end }}

# 显示统计信息
echo -e "  ${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
if [ $BINARY_INSTALLED -eq $BINARY_TOTAL ]; then
    echo -e "  ${GREEN}✓${NC} 所有声明式工具已就绪 (${GREEN}${BINARY_INSTALLED}${NC}/${BINARY_TOTAL})"
else
    echo -e "  ${YELLOW}⚠${NC} 部分工具未安装 (${GREEN}${BINARY_INSTALLED}${NC}/${BINARY_TOTAL})"
fi

# ==========================================
# 3. 脚本安装工具
# ==========================================
{{ if .packages.linux.installers }}
echo -e "\n${BLUE}🚀 正在检查脚本安装工具...${NC}"

{{ range .packages.linux.installers }}
if command_exists {{ . }}; then
    echo -e "  > {{ . }}: ${GREEN}已安装${NC}"
else
    case "{{ . }}" in
        *)
            echo -e "  > {{ . }}: ${YELLOW}跳过 (未定义安装脚本)${NC}"
            ;;
    esac
fi
{{ end }}
{{ end }}

# ==========================================
# 4. 刷新与收尾
# ==========================================
echo -e "\n${BLUE}🎨 正在刷新系统缓存...${NC}"
if command_exists fc-cache; then
    execute_with_loader "刷新字体缓存" fc-cache -f
fi

echo -e "\n${GREEN}🎉 所有声明式软件包同步完成！${NC}"
{{- end -}}