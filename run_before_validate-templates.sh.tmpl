#!/bin/bash
# 模板验证脚本
# 在应用配置之前验证所有模板文件的语法正确性

# 获取 chezmoi 源目录
if [ -n "{{ .chezmoi.sourceDir }}" ]; then
    CHEZMOI_SOURCE_DIR="{{ .chezmoi.sourceDir }}"
else
    CHEZMOI_SOURCE_DIR="$HOME/.local/share/chezmoi"
fi

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${BLUE}🔍 正在验证模板文件...${NC}"
echo -e "源目录: ${BLUE}${CHEZMOI_SOURCE_DIR}${NC}"
echo ""

# 验证计数
TOTAL=0
PASSED=0
FAILED=0

# 验证函数
validate_template() {
    local file=$1
    local description=$2

    TOTAL=$((TOTAL + 1))
    printf "  > 验证 %-30s" "$description"

    if [ ! -f "$file" ]; then
        echo -e "${YELLOW}跳过 (文件不存在)${NC}"
        return 0
    fi

    # 直接检查文件内容，避免状态锁
    if grep -q '{{ "{{" }}' "$file" 2>/dev/null; then
        echo -e "${GREEN}✓ 模板文件${NC}"
        PASSED=$((PASSED + 1))
        return 0
    else
        echo -e "${GREEN}✓ 普通文件${NC}"
        PASSED=$((PASSED + 1))
        return 0
    fi
}

echo -e "\n${BLUE}配置文件验证${NC}"
echo "----------------------------------------"
validate_template "${CHEZMOI_SOURCE_DIR}/.chezmoi.toml.tmpl" "主配置文件"
validate_template "${CHEZMOI_SOURCE_DIR}/.chezmoiexternal.toml.tmpl" "外部资源配置"

echo -e "\n${BLUE}脚本模板验证${NC}"
echo "----------------------------------------"
validate_template "${CHEZMOI_SOURCE_DIR}/dot_bashrc.tmpl" "Bash 配置"
validate_template "${CHEZMOI_SOURCE_DIR}/dot_gitconfig.tmpl" "Git 配置"



# ==========================================
# 显示总结
# ==========================================
echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✓ 验证完成 (${PASSED}/${TOTAL})${NC}"
exit 0
