{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Nerd Fonts 字体安装脚本
# 从 GitHub 下载并安装 Nerd Fonts

cd "{{ .chezmoi.sourceDir }}" || true

{{ template "script-utils.sh" . }}

# ==========================================
# 字体安装
# ==========================================
FONT_DIR="$HOME/.local/share/fonts"
NERD_FONTS_URL="https://github.com/ryanoasis/nerd-fonts/releases/latest/download"

print_header "🎨 配置 Nerd Fonts"

# 创建字体目录
mkdir -p "$FONT_DIR"

{{ range .packages.linux.fonts }}
FONT_NAME="{{ . }}"
FONT_ZIP="${FONT_NAME}.zip"
FONT_SUBDIR="$FONT_DIR/$FONT_NAME"

# 检查字体是否已安装
if [ -d "$FONT_SUBDIR" ] && [ "$(ls -A "$FONT_SUBDIR" 2>/dev/null)" ]; then
    print_ok "$FONT_NAME 已安装"
else
    print_warn "正在安装 $FONT_NAME..."

    # 下载字体
    printf "  > %-${LABEL_WIDTH}s" "下载 $FONT_NAME"
    if curl -fsSL -o "/tmp/$FONT_ZIP" "$NERD_FONTS_URL/$FONT_ZIP" 2>/dev/null; then
        echo -e "${GREEN}完成${NC}"
    else
        echo -e "${RED}失败${NC}"
        continue
    fi

    # 解压字体
    printf "  > %-${LABEL_WIDTH}s" "解压 $FONT_NAME"
    mkdir -p "$FONT_SUBDIR"
    if unzip -q -o "/tmp/$FONT_ZIP" -d "$FONT_SUBDIR" 2>/dev/null; then
        echo -e "${GREEN}完成${NC}"
    else
        echo -e "${RED}失败${NC}"
        rm -rf "$FONT_SUBDIR"
        continue
    fi

    # 清理
    rm -f "/tmp/$FONT_ZIP"
    print_ok "$FONT_NAME 安装完成"
fi
{{ end }}

# ==========================================
# 刷新字体缓存
# ==========================================
if command -v fc-cache &> /dev/null; then
    run_task_skip "刷新字体缓存" fc-cache -f
else
    print_warn "fc-cache 未安装，跳过缓存刷新"
fi

print_done "字体配置完成"
{{- end -}}
