{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Nerd Fonts 字体安装脚本
# 按声明版本下载并安装 Nerd Fonts

cd "{{ .chezmoi.sourceDir }}" || exit 1
set -euo pipefail

{{ template "script-utils.sh" . }}

# ==========================================
# 字体安装
# ==========================================
FONT_DIR="$HOME/.local/share/fonts"
FONT_MARKER_NAME=".chezmoi-font-version"

print_header "🎨 配置 Nerd Fonts"
mkdir -p "$FONT_DIR"

{{ range .packages.linux.fonts }}
FONT_NAME="{{ .name }}"
FONT_VERSION="{{ .version }}"
FONT_ZIP="${FONT_NAME}.zip"
FONT_URL="https://github.com/ryanoasis/nerd-fonts/releases/download/v${FONT_VERSION}/${FONT_ZIP}"
FONT_SUBDIR="$FONT_DIR/$FONT_NAME"
FONT_MARKER_PATH="$FONT_SUBDIR/$FONT_MARKER_NAME"
CURRENT_VERSION=""

if [ -f "$FONT_MARKER_PATH" ]; then
  CURRENT_VERSION=$(cat "$FONT_MARKER_PATH")
fi

if [ -d "$FONT_SUBDIR" ] && [ -n "$(ls -A "$FONT_SUBDIR" 2>/dev/null)" ] && [ "$CURRENT_VERSION" = "$FONT_VERSION" ]; then
  print_ok "$FONT_NAME $FONT_VERSION 已安装"
else
  if [ -n "$CURRENT_VERSION" ] && [ "$CURRENT_VERSION" != "$FONT_VERSION" ]; then
    print_warn "正在升级 $FONT_NAME: $CURRENT_VERSION -> $FONT_VERSION"
  else
    print_warn "正在安装 $FONT_NAME $FONT_VERSION..."
  fi

  rm -rf "$FONT_SUBDIR"
  mkdir -p "$FONT_SUBDIR"
  run_task "下载 $FONT_NAME" curl -fsSL -o "/tmp/$FONT_ZIP" "$FONT_URL" || {
    rm -rf "$FONT_SUBDIR"
    rm -f "/tmp/$FONT_ZIP"
    exit 1
  }
  run_task "解压 $FONT_NAME" unzip -q -o "/tmp/$FONT_ZIP" -d "$FONT_SUBDIR" || {
    rm -rf "$FONT_SUBDIR"
    rm -f "/tmp/$FONT_ZIP"
    exit 1
  }
  printf '%s\n' "$FONT_VERSION" > "$FONT_MARKER_PATH"
  rm -f "/tmp/$FONT_ZIP"
  print_ok "$FONT_NAME $FONT_VERSION 安装完成"
fi
{{ end }}

# ==========================================
# 刷新字体缓存
# ==========================================
if command -v fc-cache &> /dev/null; then
  run_task_skip "刷新字体缓存" fc-cache -f
else
  print_warn "fc-cache 未安装，跳过缓存刷新"
fi

print_done "字体配置完成"
{{- end -}}
