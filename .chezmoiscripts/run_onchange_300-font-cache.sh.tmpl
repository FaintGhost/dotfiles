{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# 字体缓存刷新脚本
# 用于在安装新字体后刷新系统字体缓存

cd "{{ .chezmoi.sourceDir }}" || true

{{ template "script-utils.sh" . }}

# ==========================================
# 刷新字体缓存
# ==========================================
echo -e "${BLUE}🎨 正在刷新系统缓存...${NC}"
if command -v fc-cache &> /dev/null; then
    execute_with_loader_skip "刷新字体缓存" fc-cache -f
    echo -e "${GREEN}✓ 字体缓存已刷新${NC}"
else
    echo -e "${GREEN}✓ fc-cache 未安装，跳过字体缓存刷新${NC}"
fi
{{- end -}}
