{{- if eq .chezmoi.os "windows" -}}
# Set the Pi theme in ~/.pi/agent/settings.json.
#
# Why a script and not a template: settings.json also holds machine-specific
# keys (defaultModel / defaultProvider / lastChangelogVersion). A full-file
# template would overwrite them with another machine's values.
# Only the "theme" key is touched. Skips cleanly when pi is not installed.
#
# Output is ASCII-only: Windows PowerShell 5.1 reads .ps1 files using the
# system code page, so non-ASCII text in this file would be garbled.

$ErrorActionPreference = 'Stop'

if (-not (Get-Command pi -ErrorAction SilentlyContinue)) {
    Write-Host 'pi not installed, skipping theme setup'
    exit 0
}

$settingsPath = Join-Path $env:USERPROFILE '.pi\agent\settings.json'
$theme = 'monokai-pro-light/monokai-pro-dark'

$dir = Split-Path -Parent $settingsPath
if (-not (Test-Path $dir)) {
    New-Item -ItemType Directory -Path $dir -Force | Out-Null
}

$data = [ordered]@{}

if (Test-Path $settingsPath) {
    try {
        $raw = Get-Content -Path $settingsPath -Raw -ErrorAction Stop
        if ($raw -and $raw.Trim().Length -gt 0) {
            $parsed = $raw | ConvertFrom-Json -ErrorAction Stop
            foreach ($p in $parsed.PSObject.Properties) {
                $data[$p.Name] = $p.Value
            }
        }
    }
    catch {
        # Unparsable file: back it up instead of silently dropping data.
        $bak = "$settingsPath.broken"
        try {
            Move-Item -Path $settingsPath -Destination $bak -Force
            Write-Host "settings.json unparsable, backed up to $bak"
        }
        catch { }
        $data = [ordered]@{}
    }
}

if ($data.Contains('theme') -and $data['theme'] -eq $theme) {
    exit 0
}

$data['theme'] = $theme
$json = $data | ConvertTo-Json -Depth 10

# Write UTF-8 without BOM
$utf8NoBom = New-Object System.Text.UTF8Encoding($false)
[System.IO.File]::WriteAllText($settingsPath, $json, $utf8NoBom)

Write-Host "Pi theme set to $theme"
{{- end -}}
