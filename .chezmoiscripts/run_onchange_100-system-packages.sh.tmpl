{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# 系统级基础软件包安装脚本
# 用于安装通过 apt 管理的基础工具

cd "{{ .chezmoi.sourceDir }}" || true

{{ template "script-utils.sh" . }}

# ==========================================
# 0. 交互式代理配置
# ==========================================
if [ -t 0 ]; then
    print_header "🌐 网络配置"
    if read -t 10 -r -p "  ? 代理地址 [IP:Port，回车跳过]: " proxy_addr < /dev/tty; then
        proxy_addr=$(echo "$proxy_addr" | xargs)
        if [ -n "$proxy_addr" ]; then
            export http_proxy="http://$proxy_addr"
            export https_proxy="http://$proxy_addr"
            export all_proxy="http://$proxy_addr"
            print_ok "已启用代理: $proxy_addr"
        fi
    fi
    echo ""
fi

# ==========================================
# 1. 基础工具安装 (APT)
# ==========================================
{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}{{ $sudo = "" }}{{ end -}}

print_header "📦 安装系统基础软件包"
run_task "更新软件包列表" {{ $sudo }}apt update -y
run_task "安装基础工具" {{ $sudo }}apt install -y {{ .packages.linux.apt | join " " }}
print_done "系统基础软件包安装完成"
{{- end -}}
