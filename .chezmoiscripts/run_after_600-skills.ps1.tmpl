{{- if eq .chezmoi.os "windows" -}}
# Install missing global skills listed in ~/.config/skills.txt (no-op in steady state; full updates: mise run skills-update)
# NOTE: cwd MUST be $HOME - the skills CLI auto-detects agents (PromptScript/Eve) from cwd; PS 5.1 misreads UTF-8-no-BOM comments, keep comments ASCII here
Set-Location $HOME
$Manifest = Join-Path $HOME '.config\skills.txt'
if (-not (Test-Path $Manifest)) { exit 0 }
if (-not (Get-Command bunx -ErrorAction SilentlyContinue)) { exit 0 }
$installed = (bunx skills list -g 2>$null | Out-String) -replace "\x1b\[[0-9;]*m", ""
Get-Content $Manifest | Where-Object { $_ -and -not $_.StartsWith('#') } | ForEach-Object {
    if ($installed -notmatch "Source: $_") {
        Write-Host "Installing skills from $_ ..."
        & (Join-Path $HOME '.config\skills-update.ps1') $_
    }
}
{{- end -}}
