{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# mise 版本管理器安装脚本
# 用于确保 mise 本体与声明工具就绪

cd "{{ .chezmoi.sourceDir }}" || exit 1
set -euo pipefail

{{ template "script-utils.sh" . }}

# ==========================================
# mise 安装
# ==========================================
{{- $sudo := "sudo " -}}
{{- if eq .chezmoi.username "root" -}}{{ $sudo = "" }}{{ end -}}

print_header "🔧 配置 mise 版本管理器"
run_task "创建 keyrings 目录" {{ $sudo }}install -dm 755 /etc/apt/keyrings || exit 1
run_task "下载 GPG 密钥" bash -c 'curl -fSs {{ .packages.linux.mise.gpg_key_url }} | {{ $sudo }}tee /etc/apt/keyrings/mise-archive-keyring.asc > /dev/null' || exit 1
run_task "添加 APT 源" bash -c 'echo "{{ .packages.linux.mise.source_line }}" | {{ $sudo }}tee /etc/apt/sources.list.d/mise.list > /dev/null' || exit 1
run_task "更新软件包列表" {{ $sudo }}apt update -y || exit 1
run_task "安装 mise" {{ $sudo }}apt install -y {{ .packages.linux.mise.package_name }} || exit 1
print_ok "mise 当前版本: $(mise --version | head -1)"

{{- if .packages.linux.mise.install_declared_tools }}
run_task "安装声明工具" mise install || exit 1
{{- end }}
run_task_skip "生成 shims" mise reshim

print_done "mise 配置完成"
{{- end -}}
