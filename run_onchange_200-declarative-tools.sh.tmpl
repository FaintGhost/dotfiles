{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# 声明式开发工具检查脚本
# 验证由 .chezmoiexternal 管理的二进制工具状态

# 切换到 chezmoi 源目录（如果需要访问源文件）
cd "{{ .chezmoi.sourceDir }}" || true

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ==========================================
# 命令检查函数
# ==========================================
command_exists() { command -v "$1" >/dev/null 2>&1; }

# ==========================================
# 声明式工具检查
# ==========================================
echo -e "${BLUE}🔧 正在检查声明式开发工具...${NC}"

# 统计变量
BINARY_TOTAL=0
BINARY_INSTALLED=0

{{ range .packages.linux.binaries }}
{{-   if eq . "uv" }}
# uv
BINARY_TOTAL=$((BINARY_TOTAL + 1))
if command_exists uv; then
    UV_VERSION=$(uv --version 2>/dev/null | awk '{print $2}')
    echo -e "  > uv: ${GREEN}已安装${NC} (${BLUE}$UV_VERSION${NC})"
    BINARY_INSTALLED=$((BINARY_INSTALLED + 1))
else
    echo -e "  > uv: ${YELLOW}未安装${NC} (将由 chezmoi external 下载)"
fi
{{-   end }}

{{-   if eq . "bun" }}
# bun
BINARY_TOTAL=$((BINARY_TOTAL + 1))
if [ -f "$HOME/.bun/bin/bun" ]; then
    BUN_VERSION=$($HOME/.bun/bin/bun --version 2>/dev/null)
    echo -e "  > bun: ${GREEN}已安装${NC} (${BLUE}$BUN_VERSION${NC})"
    BINARY_INSTALLED=$((BINARY_INSTALLED + 1))
else
    echo -e "  > bun: ${YELLOW}未安装${NC} (将由 chezmoi external 下载)"
fi
{{-   end }}

{{-   if eq . "starship" }}
# starship
BINARY_TOTAL=$((BINARY_TOTAL + 1))
if command_exists starship; then
    STARSHIP_VERSION=$(starship --version 2>/dev/null | head -1 | awk '{print $2}')
    echo -e "  > starship: ${GREEN}已安装${NC} (${BLUE}$STARSHIP_VERSION${NC})"
    BINARY_INSTALLED=$((BINARY_INSTALLED + 1))
else
    echo -e "  > starship: ${YELLOW}未安装${NC} (将由 chezmoi external 下载)"
fi
{{-   end }}

{{-   if eq . "fnm" }}
# fnm
BINARY_TOTAL=$((BINARY_TOTAL + 1))
if [ -f "$HOME/.local/share/fnm/fnm" ]; then
    FNM_VERSION=$($HOME/.local/share/fnm/fnm --version 2>/dev/null | awk '{print $2}')
    echo -e "  > fnm: ${GREEN}已安装${NC} (${BLUE}$FNM_VERSION${NC})"
    BINARY_INSTALLED=$((BINARY_INSTALLED + 1))
else
    echo -e "  > fnm: ${YELLOW}未安装${NC} (将由 chezmoi external 下载)"
fi
{{-   end }}
{{- end }}

# ==========================================
# 显示统计信息
# ==========================================
echo -e "  ${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
if [ $BINARY_INSTALLED -eq $BINARY_TOTAL ]; then
    echo -e "  ${GREEN}✓${NC} 所有声明式工具已就绪 (${GREEN}${BINARY_INSTALLED}${NC}/${BINARY_TOTAL})"
else
    echo -e "  ${YELLOW}⚠${NC} 部分工具未安装 (${GREEN}${BINARY_INSTALLED}${NC}/${BINARY_TOTAL})"
    echo -e "  ${YELLOW}提示${NC}: 运行 'chezmoi apply' 后，chezmoi 将自动下载缺失的工具"
fi

{{ if .packages.linux.installers }}
# ==========================================
# 脚本安装工具检查
# ==========================================
echo -e "\n${BLUE}🚀 正在检查脚本安装工具...${NC}"

{{ range .packages.linux.installers }}
if command_exists {{ . }}; then
    echo -e "  > {{ . }}: ${GREEN}已安装${NC}"
else
    case "{{ . }}" in
        *)
            echo -e "  > {{ . }}: ${YELLOW}跳过 (未定义安装脚本)${NC}"
            ;;
    esac
fi
{{ end }}
{{ end }}

echo -e "\n${GREEN}✓ 声明式工具检查完成${NC}"
{{- end -}}
