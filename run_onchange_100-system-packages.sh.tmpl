{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# 系统级基础软件包安装脚本
# 用于安装通过 apt 管理的基础工具

# 切换到 chezmoi 源目录（如果需要访问源文件）
cd "{{ .chezmoi.sourceDir }}" || true

# 颜色定义
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# ==========================================
# 辅助函数：进度旋转器
# ==========================================
show_spinner() {
    local pid=$1
    local delay=0.1
    local spinstr='|/-\'
    while kill -0 "$pid" 2>/dev/null; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

execute_with_loader() {
    local msg=$1
    shift
    printf "  > %-30s" "$msg"
    "$@" > /dev/null 2>&1 &
    local pid=$!
    show_spinner "$pid"
    wait "$pid"
    local exit_code=$?
    if [ $exit_code -eq 0 ]; then
        echo -e "${GREEN}完成${NC}"
    else
        echo -e "${RED}失败${NC}"
    fi
    return $exit_code
}

# ==========================================
# 0. 交互式代理配置
# ==========================================
if [ -t 0 ]; then
    echo -e "${BLUE}🌐 Network Configuration / 网络配置${NC}"
    echo "----------------------------------------"
    if read -t 10 -r -p "❓ 是否需要代理? 请输入 IP:Port [10s超时/直接回车跳过]: " proxy_addr < /dev/tty; then
        proxy_addr=$(echo "$proxy_addr" | xargs)
        if [ -n "$proxy_addr" ]; then
            export http_proxy="http://$proxy_addr"
            export https_proxy="http://$proxy_addr"
            export all_proxy="http://$proxy_addr"
            echo -e "${GREEN}✅ 已临时启用代理: $proxy_addr${NC}"
        fi
    fi
fi

# ==========================================
# 1. 基础工具安装 (APT)
# ==========================================
{{ $sudo := "sudo " -}}
{{ if eq .chezmoi.username "root" -}}{{ $sudo = "" }}{{ end -}}

echo -e "\n${BLUE}📦 正在同步系统基础软件包 (apt)...${NC}"
execute_with_loader "更新软件包列表" {{ $sudo }}apt update -y
execute_with_loader "检查并同步基础工具" {{ $sudo }}apt install -y {{ .packages.linux.apt | join " " }}

echo -e "\n${GREEN}✓ 系统基础软件包同步完成${NC}"
{{- end -}}
