# ==========================================
# 1. Windows 平台特有忽略
# ==========================================
{{- if eq .chezmoi.os "windows" }}
!.bashrc
.zshrc
.tmux.conf
.ssh/authorized_keys
.config/nvim/
!run_onchange_*.sh
{{- end }}

# ==========================================
# 2. Linux 平台特有忽略
# ==========================================
{{- if eq .chezmoi.os "linux" }}
run_onchange_*.ps1
# 如果你有 Windows 特有的配置文件夹，也可以加在这里
# AppData/
{{- end }}

# ==========================================
# 3. 全局忽略 (无论什么系统都不同步)
# ==========================================

# --- 缓存与运行时目录 ---
.cache/
.npm/
.vscode-server/
.zed_server/
.dotnet/
.gemini/
.claude/tmp/

# --- 敏感或临时文件 ---
.wget-hsts
.Xauthority
.bash_history
.zsh_history
.lesshst

# --- 编辑器/特定工具残留 ---
.config/nvim/lazy-lock.json
.python_history
__pycache__/
.DS_Store
Thumbs.db

# --- 排除 chezmoi 仓库自身的 Git 信息 (如果嵌套) ---
.git/
.gitignore