{{- $osId := .chezmoi.os -}}
{{- $arch := .chezmoi.arch -}}

{{/* 架构名称转换 */}}
{{- if eq $arch "amd64" -}}
{{-   $arch = "x86_64" -}}
{{- else if eq $arch "arm64" -}}
{{-   $arch = "aarch64" -}}
{{- end -}}

{{/* 1. 字体目录路径处理 */}}
{{- $fontDir := "" -}}
{{- if eq $osId "darwin" -}}
{{-   $fontDir = "Library/Fonts" -}}
{{- else if eq $osId "linux" -}}
{{-   $fontDir = ".local/share/fonts" -}}
{{- end -}}

{{/* 2. 非 Windows 系统的外部依赖 */}}
{{- if ne $osId "windows" -}}

{{/* Nerd Fonts 下载 */}}
{{-   if $fontDir -}}
{{-     $nfVersion := (gitHubLatestRelease "ryanoasis/nerd-fonts").TagName -}}
{{-     range .packages.linux.fonts -}}
["{{ $fontDir }}/{{ . }}"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/{{ $nfVersion }}/{{ . }}.tar.xz"
    exact = true
    refreshPeriod = "168h"
{{-     end -}}
{{-   end -}}

{{/* uv 二进制下载 */}}
{{-   $uvAsset := printf "uv-%s-unknown-linux-musl.tar.gz" $arch -}}
{{-   if eq $osId "darwin" -}}
{{-     $uvAsset = printf "uv-%s-apple-darwin.tar.gz" $arch -}}
{{-   end -}}
{{-   $uvUrl := gitHubLatestReleaseAssetURL "astral-sh/uv" $uvAsset -}}

[".local/bin/uv"]
    type = "archive-file"
    url = {{ $uvUrl | quote }}
    executable = true
    path = "uv"
    stripComponents = 1
    refreshPeriod = "168h"

[".local/bin/uvx"]
    type = "archive-file"
    url = {{ $uvUrl | quote }}
    executable = true
    path = "uvx"
    stripComponents = 1
    refreshPeriod = "168h"

{{- end -}}