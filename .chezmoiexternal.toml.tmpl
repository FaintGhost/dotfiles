# 架构标准化变量（因为不同项目使用不同的命名）
{{- $standardArch := .chezmoi.arch }}
{{- if eq $standardArch "amd64" }}{{ $standardArch = "x86_64" }}{{ end -}}
{{- if eq $standardArch "arm64" }}{{ $standardArch = "aarch64" }}{{ end -}}

{{- if ne .chezmoi.os "windows" }}

# ===== 字体 =====
{{- range .packages.linux.fonts }}
{{-   $fontDir := ".local/share/fonts" }}
{{-   if eq $.chezmoi.os "darwin" }}{{ $fontDir = "Library/Fonts" }}{{ end -}}
{{-   $nfVersion := (gitHubLatestRelease "ryanoasis/nerd-fonts").TagName }}
["{{ $fontDir }}/{{ . }}"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/{{ $nfVersion }}/{{ . }}.tar.xz"
    exact = true
    refreshPeriod = "168h"
{{- end }}

# ===== 二进制工具 =====
{{- range .packages.linux.binaries }}

{{-   if eq . "uv" }}
{{-     $uvAsset := printf "uv-%s-unknown-linux-musl.tar.gz" $standardArch }}
{{-     if eq $.chezmoi.os "darwin" }}{{ $uvAsset = printf "uv-%s-apple-darwin.tar.gz" $standardArch }}{{ end }}
[".local/bin/uv"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "astral-sh/uv" $uvAsset | quote }}
    executable = true
    path = "uv"
    stripComponents = 1
    refreshPeriod = "168h"

# uvx 通过符号链接到 uv，避免重复下载
[".local/bin/uvx"]
    type = "symlink"
    target = ".local/bin/uv"
{{-   end }}

{{-   if eq . "bun" }}
{{-     $bunArch := "x64" }}
{{-     if eq $standardArch "aarch64" }}{{ $bunArch = "aarch64" }}{{ end }}
{{-     $bunAsset := printf "bun-linux-%s.zip" $bunArch }}
{{-     if eq $.chezmoi.os "darwin" }}{{ $bunAsset = printf "bun-darwin-%s.zip" $bunArch }}{{ end }}
[".bun/bin/bun"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "oven-sh/bun" $bunAsset | quote }}
    executable = true
    path = "bun"
    stripComponents = 1
    refreshPeriod = "168h"
{{-   end }}

{{-   if eq . "starship" }}
{{-     $platform := "unknown-linux-musl" }}
{{-     if eq $.chezmoi.os "darwin" }}{{ $platform = "apple-darwin" }}{{ end }}
{{-     $target := printf "%s-%s" $standardArch $platform }}
{{-     $ext := "tar.gz" }}
[".local/bin/starship"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "starship/starship" (printf "starship-%s.%s" $target $ext) | quote }}
    executable = true
    path = "starship"
    stripComponents = 0
    refreshPeriod = "168h"
{{-   end }}

{{-   if eq . "fnm" }}
{{-     $fnmFilename := "fnm-linux" }}
{{-     if eq $.chezmoi.os "darwin" }}{{ $fnmFilename = "fnm-macos" }}{{ end }}
{{-     if eq $standardArch "aarch64" }}{{ $fnmFilename = "fnm-arm64" }}{{ end }}
{{-     $fnmAsset := printf "%s.zip" $fnmFilename }}
[".local/share/fnm/fnm"]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "Schniz/fnm" $fnmAsset | quote }}
    executable = true
    path = "fnm"
    stripComponents = 0
    refreshPeriod = "168h"
{{-   end }}

{{- end }}

{{- end }}
