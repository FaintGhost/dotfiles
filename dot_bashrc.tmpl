alias dc='docker compose'
alias t='tmux'
alias p=alias p='export http_proxy=http://192.168.50.254:2080;export https_proxy=http://192.168.50.254:2080;export all_proxy=http://192.168.50.254:2080'
export TERM=xterm-256color

# 这是一个跨行且带逻辑的“高级版 alias”
cz() {
  # 1. 执行命令
  chezmoi "$@"
  # 2. 捕获状态
  local exit_code=$?
  # 3. 跨行逻辑判断
  if [ $exit_code -eq 0 ]; then
    case "$1" in
      apply|update|init)
        echo "🚀 正在自动刷新环境..."
        source "$HOME/.bashrc"
        ;;
    esac
  fi
  return $exit_code
}

# ==========================================
# 基础环境变量配置
# ==========================================

export NO_PROXY=localhost,127.0.0.1

# PATH 去重添加函数
prepend_path() {
  case ":${PATH}:" in
    *:"$1":*) ;;  # 已存在，跳过
    *) export PATH="$1:$PATH" ;;
  esac
}

# ==========================================
# 开发工具初始化
# ==========================================

# Starship Prompt
if command -v starship &> /dev/null; then
  eval "$(starship init bash)"
fi

# opencode
prepend_path "$HOME/.opencode/bin"

# bun 全局包目录 (bun add -g 安装的包)
prepend_path "$HOME/.bun/bin"

# 用户本地二进制文件
prepend_path "$HOME/.local/bin"

# mise shims (用于所有环境)
prepend_path "$HOME/.local/share/mise/shims"

# moon CLI (official installer default path)
prepend_path "$HOME/.moon/bin"
