alias dc='docker compose'
{{- /* Proxy alias */}}
alias p='export http_proxy=http://192.168.50.254:2080;export https_proxy=http://192.168.50.254:2080;export all_proxy=http://192.168.50.254:2080'
alias t='tmux'

# 这是一个跨行且带逻辑的“高级版 alias”
cz() {
    # 1. 执行命令
    chezmoi "$@"
    
    # 2. 捕获状态
    local exit_code=$?
    
    # 3. 跨行逻辑判断
    if [ $exit_code -eq 0 ]; then
        case "$1" in
            apply|update|init)
                echo "🚀 正在自动刷新环境..."
                source "$HOME/.bashrc"
                ;;
        esac
    fi
    
    return $exit_code
}

export NO_PROXY=localhost,127.0.0.1
export OPENCODE_DISABLE_DEFAULT_PLUGINS=1

# Starship
eval "$(starship init bash)"

# uv & uvx (声明式安装路径在 ~/.local/bin)
if [ -f "$HOME/.local/bin/uv" ]; then
    export PATH="$HOME/.local/bin:$PATH"
    eval "$(uv generate-shell-completion bash)"
    eval "$(uvx --generate-shell-completion bash)"
fi

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# 加载其他环境
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# fnm
FNM_PATH="{{ .chezmoi.homeDir }}/.local/share/fnm"
if [ -d "$FNM_PATH" ]; then
  export PATH="$FNM_PATH:$PATH"
  eval "`fnm env`"
fi

# opencode
export PATH={{ .chezmoi.homeDir }}/.opencode/bin:$PATH
export PATH="$PATH:/opt/nvim-linux-x86_64/bin"
export TMPDIR="$HOME/.claude/tmp"
mkdir -p "$TMPDIR"