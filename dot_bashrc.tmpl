alias dc='docker compose'
alias t='tmux'

{{- if and .profile.shell.proxy.http .profile.shell.proxy.https .profile.shell.proxy.all }}
p() {
  export http_proxy="{{ .profile.shell.proxy.http }}"
  export https_proxy="{{ .profile.shell.proxy.https }}"
  export all_proxy="{{ .profile.shell.proxy.all }}"
}
{{- end }}

if [ -z "${TERM:-}" ] || [ "$TERM" = "dumb" ]; then
  export TERM="{{ .profile.shell.term_fallback }}"
fi

# 这是一个跨行且带逻辑的“高级版 alias”
cz() {
  chezmoi "$@"
  local exit_code=$?

  if [ $exit_code -eq 0 ]; then
    case "$1" in
      apply)
        echo "ℹ️ 仅应用本地 source；如需拉取远端更新请运行 chezmoi update 或 czu"
        echo "🚀 正在自动刷新环境..."
        source "$HOME/.bashrc"
        ;;
      update|init)
        echo "🚀 正在自动刷新环境..."
        source "$HOME/.bashrc"
        ;;
    esac
  fi

  return $exit_code
}

czu() {
  cz update "$@"
}

# ==========================================
# 基础环境变量配置
# ==========================================

export NO_PROXY=localhost,127.0.0.1

# PATH 去重添加函数
prepend_path() {
  case ":${PATH}:" in
    *:"$1":*) ;;
    *) export PATH="$1:$PATH" ;;
  esac
}

# ==========================================
# 开发工具初始化
# ==========================================

if command -v starship &> /dev/null; then
  eval "$(starship init bash)"
fi

prepend_path "$HOME/.opencode/bin"
prepend_path "$HOME/.bun/bin"
prepend_path "$HOME/.local/bin"
prepend_path "$HOME/.local/share/mise/shims"
prepend_path "$HOME/.moon/bin"
