alias dc='docker compose'
{{- /* Proxy alias - 使用环境变量配置 */}}
{{- if .proxy.enabled }}
alias p='export http_proxy={{ .proxy.http }};export https_proxy={{ .proxy.https }};export all_proxy={{ .proxy.https }}'
{{- else }}
alias p='echo "代理未启用，请在 .chezmoidata/env.yaml 中配置"'
{{- end }}
alias t='tmux'

# 这是一个跨行且带逻辑的“高级版 alias”
cz() {
    # 1. 执行命令
    chezmoi "$@"
    
    # 2. 捕获状态
    local exit_code=$?
    
    # 3. 跨行逻辑判断
    if [ $exit_code -eq 0 ]; then
        case "$1" in
            apply|update|init)
                echo "🚀 正在自动刷新环境..."
                source "$HOME/.bashrc"
                ;;
        esac
    fi
    
    return $exit_code
}

# ==========================================
# 基础环境变量配置
# ==========================================

# 代理配置
{{- if .proxy.enabled }}
export http_proxy="{{ .proxy.http }}"
export https_proxy="{{ .proxy.https }}"
export all_proxy="{{ .proxy.https }}"
{{- end }}
export NO_PROXY=localhost,127.0.0.1

# OpenCode 配置
export OPENCODE_DISABLE_DEFAULT_PLUGINS={{ .custom.opencode.disable_default_plugins }}

# 临时目录
export TMPDIR="{{ .custom.tmpdir.path }}"
mkdir -p "$TMPDIR"

# ==========================================
# PATH 管理器（按优先级排序）
# ==========================================

# 1. 用户本地二进制文件（最高优先级）
export PATH="$HOME/.local/bin:$PATH"

# 2. OpenCode 路径
{{- if .custom.opencode.path }}
export PATH="{{ .custom.opencode.path }}:$PATH"
{{- end }}

# 3. Neovim 额外路径（可选）
{{- if .custom.nvim.extra_path }}
if [ -d "{{ .custom.nvim.extra_path }}" ]; then
    export PATH="{{ .custom.nvim.extra_path }}:$PATH"
fi
{{- end }}

# ==========================================
# 开发工具初始化
# ==========================================

# Starship Prompt
if command -v starship &> /dev/null; then
    eval "$(starship init bash)"
fi

# uv & uvx (Python 包管理器)
if command -v uv &> /dev/null; then
    eval "$(uv generate-shell-completion bash)"
    # uvx 通过 uv 自动处理，不需要单独的补全
fi

# bun (JavaScript 运行时)
if [ -f "$HOME/.bun/bin/bun" ]; then
    export BUN_INSTALL="$HOME/.bun"
    export PATH="$BUN_INSTALL/bin:$PATH"
fi

# fnm (Node.js 版本管理器)
if [ -f "$HOME/.local/share/fnm/fnm" ]; then
    export PATH="$HOME/.local/share/fnm:$PATH"
    eval "$(fnm env --use-on-cd)"
fi

# 加载其他本地环境变量（如果存在）
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"