{{- $osid := .chezmoi.os -}}
{{/* 增加安全检查：确保 osRelease 存在后再访问其成员 */}}
{{- if (index .chezmoi "osRelease") -}}
  {{- if hasKey .chezmoi.osRelease "id" -}}
    {{- $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
  {{- end -}}
{{- end -}}

{{- $agekey := joinPath .chezmoi.homeDir ".config/chezmoi/key/age.txt" -}}
encryption = "age"

[data]
    osid = {{ $osid | quote }}

# ==========================================
# Age 加密配置
# ==========================================
[age]
    identity = {{ $agekey | quote }}
    recipient = "age1t445u7zvew9tnde9e7uxvux6s4h3arw378tp42pqh29y8xlutytsp7z4v5"

# ==========================================
# 编辑器配置
# ==========================================
[edit]
    command = "nvim"
    hardlink = true
    minDuration = "1s"

# ==========================================
# Git 配置
# ==========================================
[git]
    autoAdd = false
    autoCommit = true
    autoPush = false
    commitMessageTemplate = "{{ .chezmoi.command }}: {{ .chezmoi.args }}"

# ==========================================
# Diff 工具配置
# ==========================================
[diff]
    # 如果安装了 delta，取消下面注释
    # command = "delta"
    pager = "less -FRX"

# ==========================================
# 颜色输出
# ==========================================
[color]
    ui = true

# ==========================================
# 模板选项
# ==========================================
[template]
    options = ["missingkey=error"]

# ==========================================
# 更新配置
# ==========================================
[update]
    apply = true
    recurseSubmodules = true

# ==========================================
# 警告配置
# ==========================================
[warnings]
    # 当模板文件修改时显示警告
    configFileTemplateHasChanged = true