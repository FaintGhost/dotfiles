#!/bin/bash
# 模板验证脚本
# 在应用配置之前验证所有关键模板文件的渲染与 shell 语法

set -u

if [ -n "{{ .chezmoi.sourceDir }}" ]; then
  CHEZMOI_SOURCE_DIR="{{ .chezmoi.sourceDir }}"
else
  CHEZMOI_SOURCE_DIR="$HOME/.local/share/chezmoi"
fi

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

TOTAL=0
PASSED=0
FAILED=0
RENDERED_PATH=''

TEMPLATE_ONLY_ITEMS=$(cat <<'ITEMS'
.chezmoi.toml.tmpl|主配置文件
.chezmoiignore.tmpl|忽略规则模板
dot_gitconfig.tmpl|Git 配置
dot_config/mise/mise.toml.tmpl|mise 全局配置
ITEMS
)

SHELL_TEMPLATE_ITEMS=$(cat <<'ITEMS'
dot_bashrc.tmpl|Bash 配置
dot_zshrc.tmpl|Zsh 配置
run_before_validate-templates.sh.tmpl|模板验证脚本
.chezmoiscripts/run_onchange_100-system-packages.sh.tmpl|系统包安装脚本
.chezmoiscripts/run_onchange_200-mise.sh.tmpl|mise 安装脚本
.chezmoiscripts/run_onchange_300-font-cache.sh.tmpl|字体安装脚本
ITEMS
)

compact_error() {
  local file=$1
  tr '\n' ' ' < "$file" | sed 's/[[:space:]]\+/ /g; s/^ //; s/ $//'
}

print_result() {
  local status=$1
  local detail=$2
  local color="$NC"
  local label=''

  case "$status" in
    ok)
      color="$GREEN"
      label='✓ 完成'
      ;;
    fail)
      color="$RED"
      label='✗ 失败'
      ;;
  esac

  echo -e "    ${color}${label}${NC}"
  if [ "$status" = "fail" ] && [ -n "$detail" ]; then
    echo -e "    ${color}↳${NC} $detail"
  fi
}

render_template() {
  local rel_path=$1
  local abs_path="$CHEZMOI_SOURCE_DIR/$rel_path"
  local rendered_path="$TMP_DIR/$(basename "$rel_path").rendered"
  local error_path="$TMP_DIR/$(basename "$rel_path").render.err"

  if ! chezmoi execute-template --file "$abs_path" >"$rendered_path" 2>"$error_path"; then
    print_result fail "$(compact_error "$error_path")"
    FAILED=$((FAILED + 1))
    return 1
  fi

  RENDERED_PATH="$rendered_path"
  return 0
}

validate_item() {
  local rel_path=$1
  local description=$2
  local needs_bash_check=$3
  local abs_path="$CHEZMOI_SOURCE_DIR/$rel_path"
  local error_path=''

  TOTAL=$((TOTAL + 1))
  echo "  > 验证 $description"

  if [ ! -f "$abs_path" ]; then
    print_result fail "文件不存在: $rel_path"
    FAILED=$((FAILED + 1))
    return 1
  fi

  if ! render_template "$rel_path"; then
    return 1
  fi

  if [ "$needs_bash_check" = "yes" ]; then
    error_path="$TMP_DIR/$(basename "$rel_path").bash.err"
    if ! bash -n "$RENDERED_PATH" > /dev/null 2>"$error_path"; then
      print_result fail "$(compact_error "$error_path")"
      FAILED=$((FAILED + 1))
      return 1
    fi
  fi

  PASSED=$((PASSED + 1))
  print_result ok ""
}

validate_group() {
  local title=$1
  local needs_bash_check=$2
  local items=$3

  echo -e "\n${BLUE}${title}${NC}"
  echo "----------------------------------------"

  while IFS='|' read -r rel_path description; do
    if [ -z "$rel_path" ]; then
      continue
    fi
    validate_item "$rel_path" "$description" "$needs_bash_check"
  done <<EOF_ITEMS
$items
EOF_ITEMS
}

echo -e "${BLUE}🔍 正在验证模板文件...${NC}"
echo -e "源目录: ${BLUE}${CHEZMOI_SOURCE_DIR}${NC}"

validate_group "模板渲染校验" "no" "$TEMPLATE_ONLY_ITEMS"
validate_group "Shell 模板校验" "yes" "$SHELL_TEMPLATE_ITEMS"

echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
if [ "$FAILED" -eq 0 ]; then
  echo -e "${GREEN}✓ 验证完成 (${PASSED}/${TOTAL})${NC}"
  exit 0
fi

echo -e "${RED}✗ 验证失败 (${PASSED} 通过 / ${FAILED} 失败 / 共 ${TOTAL} 项)${NC}"
exit 1
