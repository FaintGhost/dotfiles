[tools]
"aqua:go-task/task" = "latest"
bun = "latest"
fd = "latest"
gh = "latest"
go = "1.26"
{{ if ne .chezmoi.os "windows" -}}
herdr = "latest"
{{ end -}}
java = "21"
node = "24"
python = "3.14"
ripgrep = "latest"
rust = "stable"
starship = "latest"
uv = "latest"

[tasks]
setup = "mise install"
update = "mise upgrade"
which = "mise where"

[settings]
python.uv_venv_auto = true

[env]
GOPATH = '{{ joinPath .chezmoi.homeDir ".local/share/go" }}'
