[tools]
"aqua:go-task/task" = "latest"
bun = "latest"
fd = "latest"
gh = "latest"
go = "1.26"
java = "21"
node = "24"
python = "3.14"
ripgrep = "latest"
rust = "stable"
starship = "latest"
uv = "latest"

# AI agent CLI(npm 后端)
"npm:@earendil-works/pi-coding-agent" = "latest"
"npm:@oh-my-pi/pi-coding-agent" = "latest"

# codex 统一用 github 后端(直接拉 GitHub Release 二进制),
# Windows 上避开官方 install.ps1 在 PowerShell 5.1 下 OSArchitecture 报错;
# release 时效敏感,显式关掉 minimum_release_age(0s = 不过滤)
[tools."github:openai/codex"]
version = "latest"
minimum_release_age = "0s"

{{ if ne .chezmoi.os "windows" -}}
# herdr 的 release 时效敏感,显式关掉 minimum_release_age
# (mise 有内置默认龄期,0s = 不过滤)
[tools.herdr]
version = "latest"
minimum_release_age = "0s"
{{ end -}}

[tasks]
setup = "mise install"
update = "mise upgrade"
which = "mise where"

[settings]
python.uv_venv_auto = true

[env]
GOPATH = '{{ joinPath .chezmoi.homeDir ".local/share/go" }}'
