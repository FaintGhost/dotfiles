{{- /* 按机器档位决定装哪些工具，见 .chezmoidata/machines.yaml */ -}}
{{- $profile := "full" -}}
{{- if hasKey .machines .chezmoi.hostname -}}
{{-   $profile = index .machines .chezmoi.hostname -}}
{{- end -}}
[tools]
# chezmoi 是所有机器都要的：没有它连 dotfiles 都拉不下来
chezmoi = { version = "latest", auto_update = true }
{{ if eq $profile "full" -}}
"aqua:go-task/task" = { version = "latest", auto_update = true }
bun = { version = "latest", auto_update = true }
fd = { version = "latest", auto_update = true }
gh = { version = "latest", auto_update = true }
go = { version = "1.26", auto_update = true }
java = { version = "21", auto_update = true }
node = { version = "24", auto_update = true }
python = { version = "3.14", auto_update = true }
ripgrep = { version = "latest", auto_update = true }
rust = { version = "stable", auto_update = true }
starship = { version = "latest", auto_update = true }
uv = { version = "latest", auto_update = true }

# AI agent CLI(npm 后端)
"npm:@earendil-works/pi-coding-agent" = { version = "latest", auto_update = true }
"npm:@oh-my-pi/pi-coding-agent" = { version = "latest", auto_update = true }
"npm:@zvec/zvec-grep" = { version = "latest", auto_update = true }

# codex 统一用 github 后端装官方 package 资产(含 bin/codex-code-mode-host
# 与 codex-path/rg 的完整布局),codex 自动识别 package 布局并启用 Code Mode;
# Windows 上避开官方 install.ps1 在 PowerShell 5.1 下 OSArchitecture 报错
[tools."github:openai/codex"]
version = "latest"
matching = "codex-package-"
bin_path = "bin"
auto_update = true

[tools.herdr]
version = "latest"
auto_update = true
{{ else -}}
# min 档：只保留 shell 必需的轻量工具，不装语言运行时和 AI agent。
# 1G 内存 / 小磁盘的机器靠这套就能跑 dotfiles 同步和日常运维。
ripgrep = { version = "latest", auto_update = true }
starship = { version = "latest", auto_update = true }
{{ end }}
[bootstrap.services.mise-tool-update]
builtin = "tool-update"

[tasks]
setup = "mise install"
update = "mise upgrade"
which = "mise where"

[settings]
minimum_release_age = "0d"
# 只用 python-build-standalone 预编译包，绝不在本机源码编译
python.compile = false
python.uv_venv_auto = true

[env]
HERDR_CONFIG_PATH = '{{ joinPath .chezmoi.homeDir ".config/herdr/config.toml" }}'
{{- if eq $profile "full" }}
GOPATH = '{{ joinPath .chezmoi.homeDir ".local/share/go" }}'
{{- end }}
