[tools]
"aqua:go-task/task" = "latest"
bun = "latest"
go = "1.26"
java = "21"
node = "24"
python = "3.14"
rust = "stable"
uv = "latest"

[tasks]
setup = "mise install"
update = "mise upgrade"
which = "mise where"

[settings]
python.uv_venv_auto = true

[env]
GOPATH = '{{ joinPath .chezmoi.homeDir ".local/share/go" }}'
