[tools]
"aqua:go-task/task" = "latest"
bun = "latest"
fd = "latest"
gh = "latest"
go = "1.26"
java = "21"
node = "24"
python = "3.14"
ripgrep = "latest"
rust = "stable"
starship = "latest"
uv = "latest"

# AI agent CLI(npm 后端)
"npm:@earendil-works/pi-coding-agent" = "latest"
"npm:@oh-my-pi/pi-coding-agent" = "latest"

# codex 统一用 github 后端装官方 package 资产(含 bin/codex-code-mode-host
# 与 codex-path/rg 的完整布局),codex 自动识别 package 布局并启用 Code Mode;
# Windows 上避开官方 install.ps1 在 PowerShell 5.1 下 OSArchitecture 报错
[tools."github:openai/codex"]
version = "latest"
matching = "codex-package-"
bin_path = "bin"

{{ if ne .chezmoi.os "windows" -}}
[tools.herdr]
version = "latest"
{{ end -}}

[tasks]
setup = "mise install"
update = "mise upgrade"
which = "mise where"
skills-update = "bunx skills update -g -y"

[settings]
python.uv_venv_auto = true

[env]
GOPATH = '{{ joinPath .chezmoi.homeDir ".local/share/go" }}'
